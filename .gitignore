# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & quality assurance
/coverage
# Regression tests are source files required by CI.
__tests__/
ci-tests.json


# documentation (all reports reside in docs/)
docs/*
!docs/AUPULENS_SUBSCRIPTION_BILLING_ACCEPTANCE_REPORT.md
!docs/AUPULENS_SUBSCRIPTION_BILLING_TEST_MATRIX.md
!docs/SUBSCRIPTION_BILLING_IMPLEMENTATION_REPORT.md
!docs/SUBSCRIPTION_BILLING_ACCEPTANCE_MATRIX.md
!docs/SUBSCRIPTION_BILLING_SETUP.md
!docs/SUBSCRIPTION_BILLING_E2E_REPORT.md

# markdown files (only README.md in root is tracked)
/*.md
!/README.md

# artifacts, evidence & audits
artifacts/
audit_output/
scratch/
all_routes.txt
inventory.json
tmp/

# root screenshots & media (preserves public/ assets)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.pdf

# spreadsheets & tabular data dumps
*.xlsx
*.xls
/*.csv

# Next.js & build caches
/.next/
/.next-*/
/.next-remediation-next/
/out/
/.turbo/
/.cache/

.env.*

# production
/build

# electron
/dist
*.exe
*.dmg
*.AppImage
*.deb

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal tooling, agent context & IDEs
CLAUDE.md
amastermds/
.claude/
*.claude
.agents/
.codex/
.aws/
.vscode/
.idea/


