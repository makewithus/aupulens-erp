# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# --- Auth (NextAuth v5) ---
NEXTAUTH_SECRET=your_nextauth_secret_32_chars
AUTH_SECRET=your_auth_secret_32_chars
ALLOW_PUBLIC_REGISTRATION=true

# --- AI (Azure OpenAI) ---
# See SETUP_AI.md for how to obtain these from the Azure Portal / Azure AI Foundry.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# Chat-completions deployment (gpt-4o) — used by every AI call.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Embeddings deployment (text-embedding-ada-002) — semantic search / RAG.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Voice-to-text (mic in the AI assistant + form fields). Dedicated Azure AI Speech resource:
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=centralindia

# Platform-wide monthly AI call ceiling (all tenants combined) — a hard
# trial-budget backstop ABOVE the per-tier caps. Defaults to 17000 if unset.
# See PROGRESS.md "AI_GLOBAL_MONTHLY_CAP" for how this number was derived.
AI_GLOBAL_MONTHLY_CAP=17000

# --- Internal ---
MIDDLEWARE_INTERNAL_SECRET=your_middleware_internal_secret
ENCRYPTION_KEY=your_encryption_key_base64
CRON_SECRET=local-dev-cron-secret-1783228506

# --- Bootstrap admin (seed scripts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
ADMIN_NAME="Admin Name"
ADMIN_PHONE=+919999999999
ADMIN_TENANT=default-tenant

# --- Cloudinary (file uploads) ---
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
NEXT_PUBLIC_CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_UPLOAD_PRESET=your_upload_preset
NEXT_PUBLIC_CLOUD_NAME=your_cloud_name

# --- App URLs (lib/config.ts) ---
# Root domain tenants live under, e.g. "companyx.aupulens.online".
# MUST be set to the real production domain in prod if it differs from the dev default.
NEXT_PUBLIC_APP_ROOT_DOMAIN=aupulens.online
# Base URL of the marketing/default-tenant site, used for redirects. Defaults to https://<NEXT_PUBLIC_APP_ROOT_DOMAIN>.
NEXT_PUBLIC_APP_BASE_URL=https://aupulens.online
# Support inbox shown in suspended/error states. Defaults to support@<NEXT_PUBLIC_APP_ROOT_DOMAIN>.
NEXT_PUBLIC_SUPPORT_EMAIL=support@aupulens.online
# Absolute API origin, only needed when the browser can't use same-origin
# relative requests (e.g. the packaged Electron app talking to a hosted API).
# Leave empty for the web app — it uses relative /api/* calls.
NEXT_PUBLIC_API_BASE_URL=

# --- Electron (desktop shell, dev only) ---
# Dev server URL the Electron shell loads when NODE_ENV=development.
ELECTRON_DEV_SERVER_URL=http://localhost:3000

# --- Outbound email (password reset, notifications) ---
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_app_password
