{
  "name": "aupulens-erp",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "seed:invoices": "npx tsx scripts/seed-invoices.ts",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "electron": "electron .",
    "electron:dev": "concurrently \"set NODE_ENV=development && next dev\" \"wait-on http://localhost:3000 && set NODE_ENV=development && electron .\"",
    "electron:build": "set ELECTRON_BUILD=true && next build && electron-builder",
    "electron:build:win": "set ELECTRON_BUILD=true && next build && electron-builder --win",
    "electron:build:mac": "set ELECTRON_BUILD=true && next build && electron-builder --mac",
    "electron:build:linux": "set ELECTRON_BUILD=true && next build && electron-builder --linux"
  },
  "build": {
    "appId": "com.aupulens.erp",
    "productName": "Aupulens ERP",
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/logo.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@json2csv/plainjs": "^7.0.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "js-levenshtein": "^1.1.6",
    "lenis": "^1.3.24",
    "lucide-react": "^0.548.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.0",
    "next": "^15.5.18",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-is": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.33",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "brace-expansion": "1.1.13",
    "postcss": "8.5.15"
  }
}
